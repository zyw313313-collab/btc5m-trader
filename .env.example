# Copy to .env only for local use. Never commit .env or real credentials.
BTC_SYMBOL=BTCUSDT
BTC_INTERVAL=5m
BTC_BASE_URL=https://api.binance.com
BTC_ACCOUNT_BASE_URL=https://testnet.binance.vision
BTC_TESTNET=true
BTC_WEBSOCKET=true
BTC_WS_URL=wss://stream.binance.com:9443/ws
BTC_PORT=8787
BTC_DB_PATH=data/btc5m.sqlite3
BTC_HISTORY_LIMIT=1000
BTC_SYNC_LIMIT=300

# Spot paper-trading costs and limits
BTC_FEE_BPS=10
BTC_SLIPPAGE_BPS=5
BTC_LIVE_TRADING=false
BTC_LIVE_CONFIRMATION=
BTC_MAX_QUOTE_PER_TRADE=50
BTC_MAX_POSITION_QUOTE=100
BTC_MIN_QUOTE_PER_TRADE=5
BTC_PAPER_QUOTE_BALANCE=1000

# Five-minute prediction market. Keep paper mode while evaluating.
BTC_PREDICTION_MODE=paper
BTC_PREDICTION_AUTO_TRADING=false
BTC_PREDICTION_FEE_BPS=20
BTC_PREDICTION_SLIPPAGE_BPS=10
BTC_PREDICTION_ENTRY_PROBABILITY=0.64
BTC_PREDICTION_DECISION_MIN_EV=0.01
BTC_PREDICTION_MAX_SPREAD_BPS=4
BTC_PREDICTION_REALTIME_STALE_MS=3000
BTC_PREDICTION_OBSERVATION_SECONDS=30
BTC_PREDICTION_NO_TRADE_LAST_SECONDS=10
BTC_PREDICTION_CLOSE_LAST_SECONDS=30

# Optional deep reference model. It is not allowed to control decisions by default.
BTC_PREDICTION_DEEP_ENABLED=true
BTC_PREDICTION_DEEP_USE_FOR_DECISION=false
BTC_PREDICTION_DEEP_MIN_TEST_ACCURACY=0.55
BTC_PREDICTION_DEEP_MAX_TEST_BRIER=0.245

# Spot-grid paper plan. It never submits grid orders.
BTC_GRID_ENABLED=false
BTC_GRID_LEVELS=5
BTC_GRID_SPACING_PCT=0.002
BTC_GRID_MIN_SPACING_PCT=0.0015
BTC_GRID_MAX_QUOTE=100

# Set these only in the local process environment or dashboard form.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
